# Copy this file to ".env" (same folder) and fill in your real Neon connection
# string. ".env" is gitignored on purpose -- it holds a password, so it must
# never be committed. This ".env.example" file (no secrets in it) is what's
# safe to commit, so anyone cloning the repo knows what variable to set.
#
# You can find this connection string in the Neon console: your project ->
# "Connect" -> pick the "psycopg2" / "Python" tab. It looks like:
#   postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
# We add "+psycopg2" after "postgresql" below because that tells SQLAlchemy
# which underlying driver to use to actually talk to Postgres.

DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>/<dbname>?sslmode=require
